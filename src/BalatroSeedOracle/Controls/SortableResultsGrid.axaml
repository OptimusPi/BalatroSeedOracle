<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BalatroSeedOracle.ViewModels.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="BalatroSeedOracle.Controls.SortableResultsGrid"
             x:DataType="vm:SortableResultsGridViewModel"
             d:DataContext="{d:DesignInstance Type=vm:SortableResultsGridViewModel}">

    <Grid RowDefinitions="Auto,*">
        <!-- Stats and Actions Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource DarkBackground}" 
                Padding="12,8"
                BorderBrush="{StaticResource ModalBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Stats Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultsCountText}" 
                               FontFamily="{StaticResource BalatroFont}"
                               FontSize="18"
                               Foreground="{StaticResource Gold}"/>
                    <TextBlock Text="{Binding StatsText}" 
                               FontSize="18"
                               Foreground="{StaticResource LightGrey}"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedCountText}" 
                               FontSize="18"
                               Foreground="{StaticResource BrightGreenEditor}"
                               VerticalAlignment="Center"
                               Margin="8,2,0,0"
                               IsVisible="{Binding HasSelection}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding CopySelectedCommand}"
                            ToolTip.Tip="Copy selected seeds (Ctrl+C)"
                            AutomationProperties.Name="Copy selected seeds"
                            Classes="btn-blue"
                            Padding="8,4"
                            IsEnabled="{Binding HasSelection}">
                        <PathIcon Data="{StaticResource ContentCopyIconData}" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding PopOutCommand}"
                            ToolTip.Tip="Open in new window"
                            AutomationProperties.Name="Open in new window"
                            Classes="btn-blue"
                            Padding="8,4">
                        <PathIcon Data="{StaticResource OpenInNewIconData}" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding ExportAllCommand}"
                            ToolTip.Tip="Export all results"
                            AutomationProperties.Name="Export all results"
                            Classes="btn-green"
                            Padding="8,4">
                        <PathIcon Data="{StaticResource FileExportIconData}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The grid itself is built in code: TreeDataGrid when this build carries an Avalonia
             Accelerate key, the free DataGrid when it does not. See SortableResultsGrid.axaml.cs. -->
        <ContentControl Grid.Row="1"
                        x:Name="GridHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
