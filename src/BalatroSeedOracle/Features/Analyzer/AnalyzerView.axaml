<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BalatroSeedOracle.ViewModels"
             xmlns:controls="using:BalatroSeedOracle.Controls"
             xmlns:conv="using:BalatroSeedOracle.Converters"
             xmlns:features="using:BalatroSeedOracle.Features.Analyzer"
             x:Class="BalatroSeedOracle.Features.Analyzer.AnalyzerView"
             x:DataType="vm:AnalyzerViewModel">

    <UserControl.Resources>
        <conv:ItemTypeToSpriteConverter x:Key="ItemTypeToSprite"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:AnalyzerViewModel/>
    </Design.DataContext>

    <!-- Compact horizontal layout: Top bar + Full-width content below -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top control bar: wraps on narrow windows so COPY URL stays reachable -->
        <Border Grid.Row="0"
                Background="{StaticResource DarkBackground}"
                BorderBrush="{StaticResource ModalBorder}"
                BorderThickness="0,0,0,2"
                Padding="16,12">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,8">
                    <TextBlock Text="SEED:"
                               FontFamily="{StaticResource BalatroFont}"
                               FontSize="18"
                               Foreground="{StaticResource Orange}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentSeed}"
                               FontFamily="{StaticResource BalatroFont}"
                               FontSize="18"
                               Foreground="{StaticResource White}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <controls:SpinnerControl Label="Deck"
                                        SpinnerType="deck"
                                        Value="{Binding SelectedDeckIndex}"
                                        Minimum="0"
                                        Maximum="14"
                                        ReadOnly="True"
                                        DisplayValues="{Binding DeckDisplayValues}"
                                        ShadowDirection="south-east"
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,8"/>

                <controls:SpinnerControl Label="Stake"
                                        SpinnerType="stake"
                                        Value="{Binding SelectedStakeIndex}"
                                        Minimum="0"
                                        Maximum="7"
                                        ReadOnly="True"
                                        DisplayValues="{Binding StakeDisplayValues}"
                                        ShadowDirection="south-east"
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,8"/>

                <controls:SpinnerControl Label="Max Ante"
                                        SpinnerType="number"
                                        Value="{Binding MaxAntePresetIndex}"
                                        Minimum="0"
                                        Maximum="3"
                                        ReadOnly="True"
                                        DisplayValues="{Binding MaxAnteDisplayValues}"
                                        ShadowDirection="south-east"
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,8"/>

                <controls:SpinnerControl Label="Shop"
                                        SpinnerType="number"
                                        Value="{Binding ShopDepthIndex}"
                                        Minimum="0"
                                        Maximum="3"
                                        ReadOnly="True"
                                        DisplayValues="{Binding ShopDepthDisplayValues}"
                                        ShadowDirection="south-east"
                                        Width="160"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,8"/>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,8">
                    <TextBlock Text="{Binding ResultCounter}"
                               FontSize="18"
                               Foreground="{StaticResource White}"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding PreviousResultCommand}"
                            IsEnabled="{Binding HasPreviousResult}"
                            ToolTip.Tip="Previous Seed (PgUp)"
                            AutomationProperties.Name="Previous Seed"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="{StaticResource ChevronLeftIconData}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding NextResultCommand}"
                            IsEnabled="{Binding HasNextResult}"
                            ToolTip.Tip="Next Seed (PgDn)"
                            AutomationProperties.Name="Next Seed"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="{StaticResource ChevronRightIconData}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,8">
                    <TextBlock Text="{Binding AnteNavigationDisplay}"
                               FontSize="18"
                               Foreground="{StaticResource White}"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding ScrollUpAnteCommand}"
                            ToolTip.Tip="Previous Ante (↑)"
                            AutomationProperties.Name="Previous Ante"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="{StaticResource ChevronUpIconData}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ScrollDownAnteCommand}"
                            ToolTip.Tip="Next Ante (↓)"
                            AutomationProperties.Name="Next Ante"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="{StaticResource ChevronDownIconData}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LoadMoreAntesCommand}"
                            ToolTip.Tip="Deepen ante walk to the next preset"
                            Content="DEEPER"
                            Classes="btn-orange"
                            Padding="10,4"
                            FontSize="14"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="COPY URL"
                        Command="{Binding CopyBlueprintUrlCommand}"
                        Classes="btn-orange"
                        Padding="16,8"
                        ToolTip.Tip="Copy Blueprint-compatible URL to clipboard"
                        VerticalAlignment="Center"
                        Margin="0,0,0,8">
                    <Button.Styles>
                        <Style Selector="Button.btn-orange">
                            <Setter Property="Background" Value="{StaticResource Orange}"/>
                            <Setter Property="Foreground" Value="{StaticResource White}"/>
                            <Setter Property="FontFamily" Value="{StaticResource BalatroFont}"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                        <Style Selector="Button.btn-orange:pointerover">
                            <Setter Property="Background" Value="{StaticResource OrangeHover}"/>
                        </Style>
                    </Button.Styles>
                </Button>

            </WrapPanel>
        </Border>

        <!-- Seed pile + loop landmarks -->
        <Border Grid.Row="1"
                Background="{StaticResource DarkBackground}"
                BorderBrush="{StaticResource ModalBorder}"
                BorderThickness="0,0,0,2"
                Padding="16,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             Text="{Binding SeedPasteText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="40"
                             MaxHeight="72"
                             FontSize="16"
                             PlaceholderText="Paste seeds or a ?seeds= share URL…"
                             CornerRadius="6"
                             BorderThickness="0"/>
                    <Button Grid.Column="1"
                            Content="LOAD PILE"
                            Command="{Binding ApplySeedPasteCommand}"
                            Classes="btn-blue"
                            Padding="16,8"
                            FontSize="16"
                            VerticalAlignment="Top"/>
                </Grid>
                <TextBlock Text="{Binding LoopWatchSummary}"
                           FontSize="16"
                           Foreground="{StaticResource VeryLightGrey}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasLoopHits}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area: Split View -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,3*">
            <!-- Left Side: Ante/Blind Tree -->
            <Border Grid.Column="0"
                    Background="{StaticResource DarkBackground}"
                    BorderBrush="{StaticResource ModalBorder}"
                    BorderThickness="0,0,2,0">
                <features:AnteTreeView DataContext="{Binding}"/>
            </Border>

            <!-- Right Side: Detailed View / Run Log -->
            <Border Grid.Column="1"
                    Background="{StaticResource DarkBackground}">
                <features:RunDetailView DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
