name: Whimsy Fables
author: "for pi — the Dicetricks core, retold luckier — or-branches every ante 2-8"
description: >
  Whimsy Dicetricks 314 with wider dice. The must-chain keeps its SIMD teeth
  (Negative skip-tag ante 4, Perkeo early, Showman holding the door). The
  stacked-Oops jackpot becomes an or across every ante 2-8 — three hits
  anywhere in that window pays the 300. The copy core gets the same widening,
  and the lucky money/mult ladders keep singing 8 to 1. Anaglyph doubles
  every tag, as always.
deck: Anaglyph
stake: White

must:
  - smallBlindTag: NegativeTag
    antes: [4]
  - legendaryJoker: Perkeo
    antes: [1,2,3]
  - joker: Showman
    antes: [1,2,3]

should:
  - or:
      - joker: OopsAll6s
        antes: [2]
      - joker: OopsAll6s
        antes: [3]
      - joker: OopsAll6s
        antes: [4]
      - joker: OopsAll6s
        antes: [5]
      - joker: OopsAll6s
        antes: [6]
      - joker: OopsAll6s
        antes: [7]
      - joker: OopsAll6s
        antes: [8]
    min: 3
    score: 300
  - or:
      - jokers: [LuckyCat, Blueprint, Brainstorm, InvisibleJoker, SockAndBuskin, HangingChad]
        antes: [2,3,4]
      - jokers: [LuckyCat, Blueprint, Brainstorm, InvisibleJoker, SockAndBuskin, HangingChad]
        antes: [5,6]
      - jokers: [LuckyCat, Blueprint, Brainstorm, InvisibleJoker, SockAndBuskin, HangingChad]
        antes: [7,8]
    min: 2
    score: 66
  - luckyMoney: [0]
    score: 8
  - luckyMoney: [1]
    score: 7
  - luckyMoney: [2]
    score: 6
  - luckyMoney: [3]
    score: 5
  - luckyMoney: [4]
    score: 4
  - luckyMoney: [5]
    score: 3
  - luckyMoney: [6]
    score: 2
  - luckyMoney: [7]
    score: 1
  - luckyMult: [0]
    score: 8
  - luckyMult: [1]
    score: 7
  - luckyMult: [2]
    score: 6
  - luckyMult: [3]
    score: 5
  - luckyMult: [4]
    score: 4
  - luckyMult: [5]
    score: 3
  - luckyMult: [6]
    score: 2
  - luckyMult: [7]
    score: 1

