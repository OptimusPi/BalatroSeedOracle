<Project>
  <!-- Centralized package versions are in Directory.Packages.props (MSBuild convention) -->

  <!-- Shared Assembly Metadata -->
  <PropertyGroup>
    <Product>Balatro Seed Oracle</Product>
    <Company>OptimusPi</Company>
    <Copyright>Copyright 2025</Copyright>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0</FileVersion>
    <AssemblyVersion>2.1.0</AssemblyVersion>
    <!-- Don't generate assembly info - let projects handle it -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Avalonia Accelerate license (TreeDataGrid / Markdown / Charts / Media).
       Avalonia *core* is MIT — free. Accelerate is a separate paid layer for some controls.

       OSS / GitHub: you do NOT need a key. Clone + build works. The license MSBuild task
       runs only when a key is present (see below). Without a key we disable the task so
       AVLIC* cannot brick contributors.

       Key sources (first wins): ACCELERATE_LICENSE_KEY env, PARCEL_LICENSE env,
       avalonia.license.local, avalonia.license. Both license files are gitignored.

       Offline keys (avln_off_key:*) validate locally and are what this subscription issues.
       Online keys (avln_on_key:*) need a portal subscription that mints tickets — ours does
       not ("This subscription doesn't provide online license keys"), so an online key fails
       AVLIC0001 on Release. That is why ACCELERATE_LICENSE_KEY is checked FIRST: PARCEL_LICENSE
       holds the short online key used by the parcel/avdt tooling, and letting it win here
       broke every Release build. Do not reorder these two.

       Defaults:
         • no key → AvaloniaUILicenseDisableTask=true (Debug and Release)
         • key + Debug → task skipped (fast local loop)
         • key + Release → task runs (ship path validates)
       Force either way: -p:AvaloniaUILicenseDisableTask=true|false -->
  <PropertyGroup>
    <_AvaloniaLicensePath Condition="Exists('$(MSBuildThisFileDirectory)avalonia.license.local')">$(MSBuildThisFileDirectory)avalonia.license.local</_AvaloniaLicensePath>
    <_AvaloniaLicensePath Condition="'$(_AvaloniaLicensePath)' == '' AND Exists('$(MSBuildThisFileDirectory)avalonia.license')">$(MSBuildThisFileDirectory)avalonia.license</_AvaloniaLicensePath>
    <_AvaloniaLicenseFile Condition="'$(_AvaloniaLicensePath)' != ''">$([System.IO.File]::ReadAllText('$(_AvaloniaLicensePath)').Trim())</_AvaloniaLicenseFile>
    <_AvaloniaLicenseKey Condition="'$(ACCELERATE_LICENSE_KEY)' != ''">$(ACCELERATE_LICENSE_KEY)</_AvaloniaLicenseKey>
    <_AvaloniaLicenseKey Condition="'$(_AvaloniaLicenseKey)' == '' AND '$(PARCEL_LICENSE)' != ''">$(PARCEL_LICENSE)</_AvaloniaLicenseKey>
    <_AvaloniaLicenseKey Condition="'$(_AvaloniaLicenseKey)' == '' AND '$(_AvaloniaLicenseFile)' != ''">$(_AvaloniaLicenseFile)</_AvaloniaLicenseKey>
    <!-- Sane default: no secret → no license task (contributors). -->
    <AvaloniaUILicenseDisableTask Condition="'$(AvaloniaUILicenseDisableTask)' == '' AND '$(_AvaloniaLicenseKey)' == ''">true</AvaloniaUILicenseDisableTask>
    <!-- With a key, still skip on Debug; Release validates. -->
    <AvaloniaUILicenseDisableTask Condition="'$(AvaloniaUILicenseDisableTask)' == '' AND '$(Configuration)' != 'Release'">true</AvaloniaUILicenseDisableTask>
  </PropertyGroup>
  <ItemGroup Condition="'$(_AvaloniaLicenseKey)' != ''">
    <AvaloniaUILicenseKey Include="$(_AvaloniaLicenseKey)" />
  </ItemGroup>

  <!-- Compiled bindings required everywhere: Desktop ships with AOT deferred (JIT Release)
       and Browser uses TrimMode=full, so any reflection-based binding would crash at
       runtime. Per Avalonia's Native AOT guidance this prop applies to all heads. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Code Quality Settings -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisMode>Default</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Android SDK Settings -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
    <AndroidSdkDirectory>$(LOCALAPPDATA)\Android\android-sdk</AndroidSdkDirectory>
  </PropertyGroup>
</Project>
