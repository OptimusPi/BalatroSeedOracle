<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No <clear />: per-user NuGet.Config (rewaffle) may merge in for Bootsharp.FileSystem.
    CPM + TreatWarningsAsErrors: two sources without mapping → NU1507.
    Same law as src/MotelyJAML/nuget.config — only Bootsharp.FileSystem from rewaffle.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="rewaffle">
      <package pattern="Bootsharp.FileSystem" />
    </packageSource>
  </packageSourceMapping>
</configuration>
