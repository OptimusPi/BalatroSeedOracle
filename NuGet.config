<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- TIER0: central package management (NU1507) requires a single package source
       (or explicit source mapping). The user-level config adds a second source
       ('rewaffle'); clear inherited sources and pin nuget.org for this repo. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
